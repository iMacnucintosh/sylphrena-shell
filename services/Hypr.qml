pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Hyprland
import Quickshell.Io
import Sylphrena.Config
import Sylphrena.I18n
import Sylphrena.Services
import qs.components.misc

Singleton {
    id: root

    readonly property var toplevels: Hyprland.toplevels
    readonly property var workspaces: Hyprland.workspaces
    readonly property var monitors: Hyprland.monitors
    readonly property bool usingLua: Hyprland.usingLua

    readonly property HyprlandToplevel activeToplevel: {
        const t = Hyprland.activeToplevel;
        return t?.workspace?.name.startsWith("special:") || Hyprland.focusedWorkspace?.toplevels.values.length > 0 ? t : null;
    }
    readonly property HyprlandWorkspace focusedWorkspace: Hyprland.focusedWorkspace
    readonly property HyprlandMonitor focusedMonitor: Hyprland.focusedMonitor
    readonly property int activeWsId: focusedWorkspace?.id ?? 1

    readonly property HyprKeyboard keyboard: extras.devices.keyboards.find(kb => kb.main) ?? null
    readonly property bool capsLock: keyboard?.capsLock ?? false
    readonly property bool numLock: keyboard?.numLock ?? false
    readonly property string defaultKbLayout: keyboard?.layout.split(",")[0] ?? "??"
    readonly property string kbLayoutFull: keyboard?.activeKeymap ?? Tr.trCtx("Unknown", "keyboard layout")
    readonly property string kbLayout: kbMap.get(kbLayoutFull) ?? "??"
    readonly property var kbMap: new Map()

    readonly property alias extras: extras
    readonly property alias options: extras.options
    readonly property alias devices: extras.devices

    property string lastSpecialWorkspace: ""

    signal configReloaded

    function normalizeFollowMouse(mode: int): int {
        if (mode === 0 || mode === 2)
            return mode;
        return 1;
    }

    function followMouseLabel(mode: int): string {
        switch (root.normalizeFollowMouse(mode)) {
        case 0:
            return Tr.tr("Never");
        case 2:
            return Tr.tr("On click");
        default:
            return Tr.tr("On hover");
        }
    }

    function generateInputLua(mode: int): string {
        const m = root.normalizeFollowMouse(mode);
        let out = "-- Auto-generated by Sylphrena. Do not edit.\n";
        out += "-- Nexus → Keyboard & mouse: window focus follows mouse (0 never, 1 on hover, 2 on click).\n";
        out += "-- Nexus → Language & region: keyboard layouts (only when chosen there).\n\n";
        out += "hl.config({\n";
        out += "    input = {\n";
        out += `        follow_mouse = ${m},\n`;
        const kb = root.keyboardInput();
        if (kb) {
            out += `        kb_layout = "${kb.layout}",\n`;
            out += `        kb_variant = "${kb.variant}",\n`;
            out += `        kb_options = "${kb.options}",\n`;
        }
        out += "    },\n";
        out += "})\n";
        return out;
    }

    // ── Keyboard layouts (Nexus → Language & region) ──

    // Every layout and variant XKB knows: [{ layout, variant, name }], from base.lst
    property var xkbLayouts: []
    // What Hyprland uses now (the system's, or hyprland.lua's) while Sylphrena manages none
    property string currentKbLayout: ""
    property string currentKbVariant: ""

    function keyboardEntries(): list<string> {
        return GlobalConfig.general.keyboardLayouts ?? [];
    }

    // The layouts shown in Nexus: Sylphrena's, or else the ones in use
    function shownKeyboardEntries(): var {
        const own = root.keyboardEntries();
        if (own.length)
            return own;
        const layouts = root.currentKbLayout.split(",").map(s => s.trim()).filter(Boolean);
        const variants = root.currentKbVariant.split(",");
        return layouts.map((l, i) => (variants[i] ?? "").trim() ? `${l}:${variants[i].trim()}` : l);
    }

    function keyboardName(entry: string): string {
        const [layout, variant] = entry.split(":");
        const hit = root.xkbLayouts.find(k => k.layout === layout && k.variant === (variant ?? ""));
        return hit ? hit.name : entry;
    }

    function keyboardInput(): var {
        const entries = root.keyboardEntries();
        if (!entries.length)
            return null;
        const parts = entries.slice(0, 4).map(e => e.split(":"));
        return {
            layout: parts.map(p => p[0]).join(","),
            variant: parts.map(p => p[1] ?? "").join(","),
            options: entries.length > 1 ? (GlobalConfig.general.keyboardSwitch ?? "") : ""
        };
    }

    function setKeyboardEntries(entries: var): void {
        GlobalConfig.general.keyboardLayouts = entries.slice(0, 4);
    }

    function applyKeyboard(): void {
        inputLuaFile.setText(root.generateInputLua(GlobalConfig.general.followMouse));
        const kb = root.keyboardInput();
        if (kb)
            Quickshell.execDetached(["hyprctl", "eval", `hl.config({ input = { kb_layout = "${kb.layout}", kb_variant = "${kb.variant}", kb_options = "${kb.options}" } })`]);
        readKeyboard.restart();
    }

    function keyboardSwitchLabel(option: string): string {
        switch (option) {
        case "grp:alt_shift_toggle":
            return Tr.tr("Alt+Shift");
        case "grp:ctrl_shift_toggle":
            return Tr.tr("Ctrl+Shift");
        case "grp:caps_toggle":
            return Tr.tr("Caps Lock");
        case "grp:win_space_toggle":
            return Tr.tr("Super+Space");
        default:
            return Tr.tr("No shortcut (only from the bar)");
        }
    }

    Timer {
        id: readKeyboard

        interval: 400
        onTriggered: kbOptionProc.running = true
    }

    Process {
        id: kbOptionProc

        command: ["sh", "-c", "hyprctl getoption input:kb_layout -j; echo; hyprctl getoption input:kb_variant -j"]
        stdout: StdioCollector {
            onStreamFinished: {
                const blocks = text.trim().split("\n").filter(Boolean);
                try {
                    root.currentKbLayout = JSON.parse(blocks[0]).str ?? "";
                    root.currentKbVariant = JSON.parse(blocks[1]).str ?? "";
                } catch (e) {}
            }
        }
    }

    function applyFollowMouse(): void {
        const m = root.normalizeFollowMouse(GlobalConfig.general.followMouse);
        inputLuaFile.setText(root.generateInputLua(m));
        // Live apply without a full reload (lua seeds the next hyprctl reload).
        Quickshell.execDetached(["hyprctl", "keyword", "input:follow_mouse", String(m)]);
    }

    function setFollowMouse(mode: int): void {
        const m = root.normalizeFollowMouse(mode);
        if (GlobalConfig.general.followMouse !== m)
            GlobalConfig.general.followMouse = m;
        root.applyFollowMouse();
    }

    function normalizeWorkspaceAnimation(mode: string): string {
        return ["slide", "slidevert", "slidefade", "slidefadevert"].includes(mode) ? mode : "fade";
    }

    function normalizeWorkspaceAnimationSpeed(speed: string): string {
        return ["slow", "fast"].includes(speed) ? speed : "normal";
    }

    function workspaceAnimationSpeedLabel(speed: string): string {
        switch (root.normalizeWorkspaceAnimationSpeed(speed)) {
        case "slow":
            return Tr.tr("Slow");
        case "fast":
            return Tr.tr("Fast");
        default:
            return Tr.tr("Normal");
        }
    }

    function workspaceAnimationLabel(mode: string): string {
        switch (root.normalizeWorkspaceAnimation(mode)) {
        case "slide":
            return Tr.tr("Slide");
        case "slidevert":
            return Tr.tr("Slide vertically");
        case "slidefade":
            return Tr.tr("Slide and fade");
        case "slidefadevert":
            return Tr.tr("Slide and fade vertically");
        default:
            return Tr.tr("Fade");
        }
    }

    // Hyprland's own fade is what a stock config has; "slide" modes override the three workspace leaves.
    function workspaceAnimationLua(mode: string, speedName: string): string {
        const m = root.normalizeWorkspaceAnimation(mode);
        const slide = m !== "fade";
        const style = m.startsWith("slidefade") ? `${m} 20%` : m;
        const curve = slide ? "sylphrena-quint" : "sylphrena-almostlinear";
        const base = ({ slow: 7, normal: 4, fast: 2.5 })[root.normalizeWorkspaceAnimationSpeed(speedName)];
        const speeds = slide ? [base, base, base] : [1.94, 1.21, 1.94];
        let out = 'hl.curve("sylphrena-quint", { type = "bezier", points = { { 0.23, 1 }, { 0.32, 1 } } })\n';
        out += 'hl.curve("sylphrena-almostlinear", { type = "bezier", points = { { 0.5, 0.5 }, { 0.75, 1 } } })\n';
        ["workspaces", "workspacesIn", "workspacesOut"].forEach((leaf, i) => {
            out += `hl.animation({ leaf = "${leaf}", enabled = true, speed = ${speeds[i]}, bezier = "${curve}", style = "${style}" })\n`;
        });
        return out;
    }

    function generateAnimationLua(mode: string): string {
        let out = "-- Auto-generated by Sylphrena. Do not edit.\n";
        out += "-- Nexus → Activities: animation between workspaces (fade, slide, slide and fade).\n\n";
        // Fade is Hyprland's default: leave the user's own animation settings alone.
        if (root.normalizeWorkspaceAnimation(mode) !== "fade")
            out += root.workspaceAnimationLua(mode, GlobalConfig.general.workspaceAnimationSpeed);
        return out;
    }

    // changed: the user picked a mode (so "fade" must undo a previous slide); otherwise only non-default modes are applied.
    function applyWorkspaceAnimation(changed: bool): void {
        const m = root.normalizeWorkspaceAnimation(GlobalConfig.general.workspaceAnimation);
        animationLuaFile.setText(root.generateAnimationLua(m));
        if (m !== "fade" || changed)
            Quickshell.execDetached(["hyprctl", "eval", root.workspaceAnimationLua(m, GlobalConfig.general.workspaceAnimationSpeed)]);
    }

    readonly property bool activityAnimationDiffers: normalizeWorkspaceAnimation(GlobalConfig.general.activityAnimation) !== normalizeWorkspaceAnimation(GlobalConfig.general.workspaceAnimation) || normalizeWorkspaceAnimationSpeed(GlobalConfig.general.activityAnimationSpeed) !== normalizeWorkspaceAnimationSpeed(GlobalConfig.general.workspaceAnimationSpeed)

    function oneLine(lua: string): string {
        return lua.trim().replace(/\n/g, " ");
    }

    // Jump to a workspace of another activity with the activity animation: set it, jump (same socket, so in
    // order) and put the desktop one back once the transition has played.
    function focusWorkspaceInOtherActivity(ws: int): void {
        extras.batchMessage([`eval ${oneLine(workspaceAnimationLua(GlobalConfig.general.activityAnimation, GlobalConfig.general.activityAnimationSpeed))}`, `dispatch hl.dsp.focus({ workspace = ${ws} })`]);
        restoreDesktopAnimation.restart();
    }

    Timer {
        id: restoreDesktopAnimation

        interval: 1200
        onTriggered: extras.batchMessage([`eval ${root.oneLine(root.workspaceAnimationLua(GlobalConfig.general.workspaceAnimation, GlobalConfig.general.workspaceAnimationSpeed))}`])
    }

    function dispatch(request: string): void {
        Hyprland.dispatch(request);
    }

    function focusWorkspace(ws: var): void {
        dispatch(usingLua ? `hl.dsp.focus({ workspace = "${ws}" })` : `workspace ${ws}`);
    }

    property var pendingFocusToplevel: null

    readonly property Timer focusDefer: Timer {
        interval: 80
        repeat: false
        onTriggered: {
            const t = root.pendingFocusToplevel;
            root.pendingFocusToplevel = null;
            if (t)
                root.focusToplevelNow(t);
        }
    }

    function focusToplevel(toplevel: var, defer: bool): void {
        if (!toplevel)
            return;
        if (defer) {
            root.pendingFocusToplevel = toplevel;
            focusDefer.restart();
            return;
        }
        root.focusToplevelNow(toplevel);
    }

    function focusToplevelNow(toplevel: var): void {
        if (!toplevel)
            return;
        const raw = String(toplevel.address ?? "");
        if (!raw)
            return;
        const addr = raw.startsWith("0x") ? raw : `0x${raw}`;
        const wsId = toplevel.workspace?.id ?? toplevel.lastIpcObject?.workspace?.id;
        if (wsId != null && wsId !== root.activeWsId)
            root.focusWorkspace(wsId);
        dispatch(usingLua ? `hl.dsp.focus({ window = "address:${addr}" })` : `focuswindow address:${addr}`);
    }

    function normalizeAppToken(value: string): string {
        return String(value || "").trim().toLowerCase().replace(/\.desktop$/, "");
    }

    function collectAppTokens(hints: var): list<string> {
        const tokens = [];
        const push = v => {
            const t = root.normalizeAppToken(v);
            if (t && !tokens.includes(t))
                tokens.push(t);
        };

        const desktopEntry = hints?.desktopEntry ?? "";
        push(desktopEntry);
        if (desktopEntry) {
            const entry = DesktopEntries.byId(desktopEntry) || DesktopEntries.byId(`${desktopEntry}.desktop`);
            push(entry?.id);
            push(entry?.startupClass);
            push(entry?.name);
        }

        const appName = hints?.appName ?? "";
        push(appName);
        if (appName) {
            const entry = DesktopEntries.heuristicLookup(appName);
            push(entry?.id);
            push(entry?.startupClass);
            push(entry?.name);
        }

        const appIcon = hints?.appIcon ?? "";
        push(appIcon);
        if (appIcon) {
            const entry = DesktopEntries.heuristicLookup(appIcon);
            push(entry?.id);
            push(entry?.startupClass);
            push(entry?.name);
        }

        return tokens;
    }

    function scoreToplevelForApp(toplevel: var, tokens: list<string>): int {
        const ipc = toplevel?.lastIpcObject;
        const cls = root.normalizeAppToken(ipc?.class);
        const initial = root.normalizeAppToken(ipc?.initialClass);
        if (!cls && !initial)
            return -1;

        let best = -1;
        for (const token of tokens) {
            if (!token)
                continue;
            if (cls === token || initial === token)
                best = Math.max(best, 100);
            else if (cls.endsWith(`.${token}`) || initial.endsWith(`.${token}`))
                best = Math.max(best, 80);
            else if ((token.length >= 3 && (cls.includes(token) || initial.includes(token))) || (cls.length >= 3 && token.includes(cls)) || (initial.length >= 3 && token.includes(initial)))
                best = Math.max(best, 40);
        }

        // Prefer visible windows, but still allow focusing minimized/hidden ones.
        if (best >= 0 && ipc && !ipc.mapped)
            best = Math.max(1, best - 25);

        return best;
    }

    function findAppToplevel(hints: var): var {
        const tokens = root.collectAppTokens(hints);
        if (tokens.length === 0)
            return null;

        let best = null;
        let bestScore = -1;
        for (const t of toplevels.values) {
            const score = root.scoreToplevelForApp(t, tokens);
            if (score > bestScore) {
                bestScore = score;
                best = t;
            }
        }

        return bestScore >= 0 ? best : null;
    }

    function focusApp(hints: var, defer: bool): bool {
        const best = root.findAppToplevel(hints);
        if (!best)
            return false;
        root.focusToplevel(best, defer);
        return true;
    }

    // Workspaces whose windows are slid off-screen by "show desktop" (the bar draws their pill as an outline).
    property var hiddenWs: []

    function isDesktopHidden(ws: int): bool {
        return hiddenWs.includes(ws);
    }

    function runShowDesktop(args: var): void {
        if (showDesktopProc.running)
            return;
        showDesktopProc.command = ["python3", Quickshell.shellPath("scripts/show-desktop.py"), ...args];
        showDesktopProc.running = true;
    }

    // Slide the active workspace's windows off the screen (they stay on the workspace); again to bring them back.
    function toggleShowDesktop(): void {
        runShowDesktop(["toggle", String(activeWsId)]);
    }

    Process {
        id: showDesktopProc

        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    root.hiddenWs = JSON.parse(text);
                } catch (e) {
                    root.hiddenWs = [];
                }
            }
        }
    }

    function toggleSpecial(name: string): void {
        dispatch(usingLua ? `hl.dsp.workspace.toggle_special("${name}")` : `togglespecialworkspace ${name}`);
    }

    function cycleSpecialWorkspace(direction: string): void {
        const openSpecials = workspaces.values.filter(w => w.name.startsWith("special:") && w.lastIpcObject.windows > 0);

        if (openSpecials.length === 0)
            return;

        const activeSpecial = focusedMonitor.lastIpcObject.specialWorkspace.name ?? "";

        if (!activeSpecial) {
            if (lastSpecialWorkspace) {
                const workspace = workspaces.values.find(w => w.name === lastSpecialWorkspace);
                if (workspace && workspace.lastIpcObject.windows > 0) {
                    focusWorkspace(lastSpecialWorkspace);
                    return;
                }
            }
            focusWorkspace(openSpecials[0].name);
            return;
        }

        const currentIndex = openSpecials.findIndex(w => w.name === activeSpecial);
        let nextIndex = 0;

        if (currentIndex !== -1) {
            if (direction === "next")
                nextIndex = (currentIndex + 1) % openSpecials.length;
            else
                nextIndex = (currentIndex - 1 + openSpecials.length) % openSpecials.length;
        }

        focusWorkspace(openSpecials[nextIndex].name);
    }

    function monitorNames(): list<string> {
        return monitors.values.map(e => e.name);
    }

    function monitorFor(screen: ShellScreen): HyprlandMonitor {
        return Hyprland.monitorFor(screen);
    }

    function trimWsName(name: string): string {
        return name.startsWith("special:") ? name.slice("special:".length) : name;
    }

    function toplevelsForWs(ws: int, ignoredTags = []): list<HyprlandToplevel> {
        // Sort left→right, then top→bottom so bar/overview icons match layout
        return toplevels.values.filter(t => t.workspace && t.workspace.id === ws && !isToplevelIgnored(t, ignoredTags)).slice().sort((a, b) => {
            const aa = a?.lastIpcObject?.at;
            const bb = b?.lastIpcObject?.at;
            if (!aa || !bb)
                return !aa - !bb;
            return (aa[0] - bb[0]) || (aa[1] - bb[1]);
        });
    }

    function isToplevelIgnored(toplevel: HyprlandToplevel, ignoredTags = []): bool {
        const ipc = toplevel?.lastIpcObject;
        if (!ipc?.class || !ipc.mapped)
            return true;

        return ipc.tags?.some(tag => ignoredTags.includes(tag.replace(/\*$/, ""))) ?? false;
    }

    function reloadDynamicConfs(): void {
        if (usingLua) {
            extras.batchMessage(['eval hl.bind("Caps_Lock", hl.dsp.global("sylphrena:refreshDevices"), { locked = true, non_consuming = true, ignore_mods = true, release = true })', 'eval hl.bind("Num_Lock", hl.dsp.global("sylphrena:refreshDevices"), { locked = true, non_consuming = true, ignore_mods = true, release = true })', 'eval hl.bind("code:66", hl.dsp.global("sylphrena:refreshDevices"), { locked = true, non_consuming = true, ignore_mods = true, release = true })']);
        } else {
            extras.batchMessage(["keyword bindlni ,Caps_Lock,global,sylphrena:refreshDevices", "keyword bindlni ,Num_Lock,global,sylphrena:refreshDevices", "keyword bindlni ,code:66,global,sylphrena:refreshDevices"]);
        }
        // Re-assert after reloads so a stale hyprland.lua value cannot win.
        root.applyFollowMouse();
        root.applyWorkspaceAnimation(false);
    }

    onUsingLuaChanged: reloadDynamicConfs()
    Component.onCompleted: {
        reloadDynamicConfs();
        runShowDesktop(["status"]);
        readKeyboard.restart();
    }

    Connections {
        target: GlobalConfig.general
        function onFollowMouseChanged(): void {
            root.applyFollowMouse();
        }

        function onKeyboardLayoutsChanged(): void {
            root.applyKeyboard();
        }

        function onKeyboardSwitchChanged(): void {
            root.applyKeyboard();
        }

        function onWorkspaceAnimationChanged(): void {
            root.applyWorkspaceAnimation(true);
        }

        function onWorkspaceAnimationSpeedChanged(): void {
            root.applyWorkspaceAnimation(true);
        }

        function onActivityAnimationChanged(): void {
            root.applyWorkspaceAnimation(true);
        }

        function onActivityAnimationSpeedChanged(): void {
            root.applyWorkspaceAnimation(true);
        }
    }

    Connections {
        function onRawEvent(event: HyprlandEvent): void {
            const n = event.name;
            if (n.endsWith("v2"))
                return;

            if (n === "configreloaded") {
                root.configReloaded();
                root.reloadDynamicConfs();
            } else if (["workspace", "moveworkspace", "activespecial", "focusedmon"].includes(n)) {
                Hyprland.refreshWorkspaces();
                Hyprland.refreshMonitors();
            } else if (["openwindow", "closewindow", "movewindow"].includes(n)) {
                Hyprland.refreshToplevels();
                Hyprland.refreshWorkspaces();
            } else if (n.includes("mon")) {
                Hyprland.refreshMonitors();
            } else if (n.includes("workspace")) {
                Hyprland.refreshWorkspaces();
            } else if (n.includes("window") || n.includes("group") || ["pin", "fullscreen", "changefloatingmode", "minimize"].includes(n)) {
                Hyprland.refreshToplevels();
            }
        }

        target: Hyprland
    }

    Connections {
        function onLastIpcObjectChanged(): void {
            const specialName = root.focusedMonitor.lastIpcObject.specialWorkspace.name;

            if (specialName && specialName.startsWith("special:")) {
                root.lastSpecialWorkspace = specialName;
            }
        }

        target: root.focusedMonitor
    }

    FileView {
        id: inputLuaFile

        printErrors: false
        path: `${Quickshell.env("HOME")}/.config/hypr/sylphrena-input.lua`
    }

    FileView {
        id: animationLuaFile

        printErrors: false
        path: `${Quickshell.env("HOME")}/.config/hypr/sylphrena-animation.lua`
    }

    FileView {
        id: kbLayoutFile

        path: Quickshell.env("SYLPHRENA_XKB_RULES_PATH") || "/usr/share/X11/xkb/rules/base.lst"
        onLoaded: {
            // Every layout and variant, for the editor in Nexus
            const all = [];
            const lay = text().match(/! layout\n([\s\S]*?)\n\n/);
            for (const line of (lay ? lay[1].split("\n") : [])) {
                const m = line.match(/^\s*(\S+)\s+(.+)$/);
                if (m)
                    all.push({ layout: m[1], variant: "", name: m[2].trim() });
            }
            const vars = text().match(/! variant\n([\s\S]*?)\n\n/);
            for (const line of (vars ? vars[1].split("\n") : [])) {
                const m = line.match(/^\s*(\S+)\s+(\S+): (.+)$/);
                if (m)
                    all.push({ layout: m[2], variant: m[1], name: m[3].trim() });
            }
            root.xkbLayouts = all;

            const layoutMatch = text().match(/! layout\n([\s\S]*?)\n\n/);
            if (layoutMatch) {
                const lines = layoutMatch[1].split("\n");
                for (const line of lines) {
                    if (!line.trim() || line.trim().startsWith("!"))
                        continue;

                    const match = line.match(/^\s*([a-z]{2,})\s+([a-zA-Z() ]+)$/);
                    if (match)
                        root.kbMap.set(match[2], match[1]);
                }
            }

            const variantMatch = text().match(/! variant\n([\s\S]*?)\n\n/);
            if (variantMatch) {
                const lines = variantMatch[1].split("\n");
                for (const line of lines) {
                    if (!line.trim() || line.trim().startsWith("!"))
                        continue;

                    const match = line.match(/^\s*([a-zA-Z0-9_-]+)\s+([a-z]{2,}): (.+)$/);
                    if (match)
                        root.kbMap.set(match[3], match[2]);
                }
            }
        }
    }

    IpcHandler {
        function refreshDevices(): void {
            extras.refreshDevices();
        }

        function cycleSpecialWorkspace(direction: string): void {
            root.cycleSpecialWorkspace(direction);
        }

        function toggleShowDesktop(): void {
            root.toggleShowDesktop();
        }

        function listSpecialWorkspaces(): string {
            return root.workspaces.values.filter(w => w.name.startsWith("special:") && w.lastIpcObject.windows > 0).map(w => w.name).join("\n");
        }

        target: "hypr"
    }

    // qmllint disable unresolved-type
    CustomShortcut {
        // qmllint enable unresolved-type
        name: "refreshDevices"
        description: "Reload devices"
        onPressed: extras.refreshDevices()
        onReleased: extras.refreshDevices()
    }

    HyprExtras {
        id: extras

        usingLua: Hyprland.usingLua
    }
}
